# Copiar a .env y ajustar por ambiente. Nunca subir .env al repositorio.
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=clivora.ejemplo.com
CSRF_TRUSTED_ORIGINS=https://clivora.ejemplo.com
DATABASE_URL=postgres://clivora:contraseña@localhost:5432/clivora
TIME_ZONE=America/Monterrey
MEDIA_ROOT=/srv/clivora/media
LOG_LEVEL=INFO
# Correo saliente (citas y restablecer contraseña): lo normal es configurarlo en
# Clivora → Configuración → Sistema → Servidor de correo. Estas variables solo se
# usan mientras ahí no esté activado; sin EMAIL_BACKEND se imprimen en la consola.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.ejemplo.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-responder@ejemplo.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Clivora <no-responder@ejemplo.com>
# Vigencia en segundos del enlace para restablecer la contraseña (2 h).
PASSWORD_RESET_TIMEOUT=7200
